{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "blockforge/datasets",
    "description": "A dataset/content-collection module for the Blockforge CMS.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "blockforge/cms": "@dev",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Blockforge\\Datasets\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Pennywise96/blockforge-cms"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Blockforge\\Datasets\\Providers\\DatasetServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/pest"
        ],
        "pint": [
            "vendor/bin/pint"
        ]
    }
}
